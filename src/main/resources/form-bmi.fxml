<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.BmiController" spacing="10.0"
      prefWidth="480.0" prefHeight="560.0"
      style="-fx-background-color: #f8fafc; -fx-font-family: 'SansSerif'; -fx-font-size: 14px;">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
    <children>
        <Label text="Kalkulator BMI" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        <Label text="Isi data, lalu hitung indeks massa tubuh." wrapText="true" style="-fx-text-fill: #64748b;"/>
        <Label text="Nama"/>
        <TextField fx:id="namaField" promptText="Contoh: Rani"/>
        <Label text="Berat badan (kg)"/>
        <TextField fx:id="beratField" promptText="Contoh: 60"/>
        <Label text="Tinggi badan (cm)"/>
        <TextField fx:id="tinggiField" promptText="Contoh: 165"/>
        <Button text="Hitung BMI" onAction="#hitung" defaultButton="true" maxWidth="Infinity"
                style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8;"/>
        <Button text="Reset" onAction="#reset" maxWidth="Infinity"
                style="-fx-background-color: #e2e8f0; -fx-text-fill: #0f172a; -fx-padding: 10; -fx-background-radius: 8;"/>
        <Label fx:id="hasilLabel" text="Hasil perhitungan akan tampil di sini." wrapText="true" minHeight="95.0"/>
    </children>
</VBox>
